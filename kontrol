<style>
:root{
  --cream:#FAF6EF; --paper:#FFFDF8; --espresso:#3B2A20; --espresso-soft:#5A4436;
  --line:#E3D9C8; --ink:#2B2018; --muted:#8A7A68;
  --gron:#00B050; --gul:#F2C200; --rod:#E03131;
}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{margin:0;padding:0}
body{background:var(--cream);color:var(--ink);font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;font-size:16px;line-height:1.45;padding-bottom:96px}
h1,h2,h3,.serif{font-family:Georgia,"Times New Roman",serif;font-weight:600}
header{background:var(--espresso);color:#F3EADA;padding:calc(env(safe-area-inset-top) + 14px) 16px 14px;position:sticky;top:0;z-index:50}
header h1{margin:0;font-size:19px;letter-spacing:.3px}
header .sub{font-size:12.5px;opacity:.75;margin-top:3px}
.wrap{max-width:820px;margin:0 auto;padding:16px}
.card{background:var(--paper);border:1px solid var(--line);border-radius:12px;padding:14px;margin-bottom:14px}
label.fld{display:block;font-size:12px;text-transform:uppercase;letter-spacing:.7px;color:var(--muted);margin-bottom:5px}
select,input[type=text],input[type=date],textarea{width:100%;padding:11px 12px;border:1px solid var(--line);border-radius:9px;background:#fff;font-size:16px;font-family:inherit;color:var(--ink)}
textarea{resize:vertical;min-height:52px}
.row{display:flex;gap:10px}.row>*{flex:1}
.mb{margin-bottom:12px}
button{font-family:inherit;font-size:16px;border:none;border-radius:10px;padding:13px 16px;background:var(--espresso);color:#F3EADA;width:100%;cursor:pointer}
button.ghost{background:transparent;color:var(--espresso);border:1px solid var(--line)}
button.small{padding:9px 12px;font-size:14px;width:auto}
.tabs{display:flex;gap:8px;margin-bottom:14px}
.tabs button{flex:1;background:var(--paper);color:var(--espresso-soft);border:1px solid var(--line);font-family:Georgia,serif}
.tabs button.on{background:var(--espresso);color:#F3EADA;border-color:var(--espresso)}
.area{background:var(--paper);border:1px solid var(--line);border-radius:12px;margin-bottom:12px;overflow:hidden}
.area>summary{list-style:none;padding:14px;display:flex;align-items:center;gap:10px;cursor:pointer;font-family:Georgia,serif;font-size:16.5px}
.area>summary::-webkit-details-marker{display:none}
.area>summary .nm{flex:1}
.pills{display:flex;gap:5px}
.pill{min-width:26px;text-align:center;font-size:12px;font-weight:700;padding:2px 6px;border-radius:20px;color:#fff;font-family:-apple-system,sans-serif}
.pill.g{background:var(--gron)}.pill.y{background:var(--gul);color:#4a3a00}.pill.r{background:var(--rod)}
.pill.z{background:#DED4C2;color:#8A7A68}
.grp{padding:4px 14px 0;font-family:Georgia,serif;font-size:13px;letter-spacing:.5px;text-transform:uppercase;color:var(--muted);margin-top:10px}
.q{padding:11px 14px;border-top:1px solid var(--line)}
.q .txt{font-size:15px;margin-bottom:9px}
.sev{display:flex;gap:6px}
.sev button{flex:1;padding:10px 4px;font-size:13px;background:#fff;border:1px solid var(--line);color:var(--muted);border-radius:9px}
.sev button.on[data-s="0"]{background:var(--espresso);color:#F3EADA;border-color:var(--espresso)}
.sev button.on[data-s="1"]{background:var(--gron);color:#fff;border-color:var(--gron)}
.sev button.on[data-s="2"]{background:var(--gul);color:#4a3a00;border-color:var(--gul)}
.sev button.on[data-s="3"]{background:var(--rod);color:#fff;border-color:var(--rod)}
.q textarea{margin-top:9px;display:none}
.q.hasnote textarea,.q.open textarea{display:block}
table.res{width:100%;border-collapse:collapse;font-size:14.5px}
table.res td{padding:9px 4px;border-bottom:1px dotted var(--line)}
table.res td.n{text-align:center;width:44px;font-weight:700}
table.res tr.tot td{border-top:2px solid var(--espresso);border-bottom:none;font-weight:700;padding-top:11px}
.legend{font-size:13px;color:var(--muted);line-height:1.7}
.dot{display:inline-block;width:11px;height:11px;border-radius:50%;margin-right:6px;vertical-align:-1px}
.bar{position:fixed;bottom:0;left:0;right:0;background:var(--paper);border-top:1px solid var(--line);padding:10px 16px calc(env(safe-area-inset-bottom) + 10px);display:flex;gap:10px;z-index:60}
.bar .sum{flex:1;display:flex;align-items:center;gap:5px}
.omrnote{padding:12px 14px 14px;border-top:1px solid var(--line);background:#FDFBF5}
.hide{display:none}
.note{font-size:12.5px;color:var(--muted);margin-top:8px}
</style>
</head>
<body>
<header>
  <h1 id="hTitle">Kaiser Kontrol</h1>
  <div class="sub" id="hSub">Intern fødevarekontrol</div>
</header>

<div class="wrap">

  <div class="card" id="setup">
    <div class="mb">
      <label class="fld" for="afd">Afdeling</label>
      <select id="afd"></select>
    </div>
    <div class="row mb">
      <div>
        <label class="fld" for="dato">Dato</label>
        <input type="date" id="dato">
      </div>
      <div>
        <label class="fld" for="kontrollant">Kontrollant</label>
        <input type="text" id="kontrollant" placeholder="Navn">
      </div>
    </div>
    <div class="legend">
      <span class="dot" style="background:var(--espresso)"></span>OK — ingen bemærkning<br>
      <span class="dot" style="background:var(--gron)"></span>Grøn — mindre bemærkning<br>
      <span class="dot" style="background:var(--gul)"></span>Gul — bemærkning der skal rettes<br>
      <span class="dot" style="background:var(--rod)"></span>Rød — alvorlig/kritisk afvigelse
    </div>
  </div>

  <div class="tabs">
    <button id="tBoh" class="on" onclick="setTab('boh')">Back of house</button>
    <button id="tFoh" onclick="setTab('foh')">Front of house</button>
    <button id="tRes" onclick="setTab('res')">Resultat</button>
  </div>

  <div id="areas"></div>

  <div id="result" class="hide">
    <div class="card">
      <h2 style="margin:0 0 10px;font-size:17px">Resultat — Back of house</h2>
      <table class="res" id="resBoh"></table>
    </div>
    <div class="card">
      <h2 style="margin:0 0 10px;font-size:17px">Resultat — Front of house</h2>
      <table class="res" id="resFoh"></table>
    </div>
    <div class="card">
      <h2 style="margin:0 0 10px;font-size:17px">Samlet</h2>
      <table class="res" id="resAll"></table>
      <div class="note" id="resMeta"></div>
    </div>
    <div class="card">
      <label class="fld" for="opsum">Samlet kommentar til afdelingen</label>
      <textarea id="opsum" rows="4" placeholder="Skrives med i mailen…"></textarea>
      <div style="height:10px"></div>
      <button onclick="sendMail()">✉️ Send mail til afdeling</button>
      <div style="height:8px"></div>
      <button class="ghost" onclick="nulstil()">Nulstil denne kontrol</button>
    </div>
  </div>

</div>

<div class="bar">
  <div class="sum" id="barSum"></div>
  <button class="small" onclick="setTab('res')">Resultat</button>
  <button class="small" onclick="sendMail()">✉️ Mail</button>
</div>
<script>
/* ============================================================
   KONFIGURATION — ret kun herinde
   ============================================================ */

/* Afdelinger og modtager-mails. Tilføj/fjern frit.
   Flere modtagere: adskil med komma i "mail". */
const AFDELINGER = [
  { navn: "Helsingør",      mail: "Helsingoer@cafekaiser.dk" },
  { navn: "Hillerød",       mail: "Hilleroed@cafekaiser.dk" },
  { navn: "Farum",          mail: "Farum@cafekaiser.dk" },
  { navn: "Hørsholm",       mail: "Hoersholm@cafekaiser.dk" },
  { navn: "Vanløse",        mail: "Vanloese@cafekaiser.dk" },
  { navn: "Enghave Brygge", mail: "Enghavebrygge@cafekaiser.dk" }
];

/* Sæt CC på alle mails (fx dig selv). Tom streng = ingen cc. */
const CC_MAIL = "";

/* Point-/niveaunavne — bruges i skema, resultat og mail */
const NIVEAU = ["OK", "Grøn", "Gul", "Rød"];

/* ============================================================
   SKEMA — hentet 1:1 fra kontrolarket
   ============================================================ */
const DATA = {
  boh: {
    "Opvaskeområde": [{"t": "Opvaskemaskine", "q": ["Rammer maskinen 80 grader ved slutskyl?", "Er maskinen pæn og ren indvendigt?", "Er maskinen pæn og ren udvendigt?", "Er vandforsyning ok?", "Er der adgang til håndvask med sæbe og papir?", "Andet"]}, {"t": "Borde og hylder", "q": ["Er bordene rene og pæne?", "Er hylderne pæne og rene?", "Er udstyret, som opbevares i området, pæne og rene?", "Er kasser, som bruges til opbevaring pæne og rene?", "Andet"]}, {"t": "Gulvet", "q": ["Er gulvet pænt og rent?", "Er der riste i afløb?", "Er afløbene pæne og rene?", "Er udstyr til gulvvask i orden?", "Er kanter, lister og gulv intakt?", "Andet:"]}, {"t": "Vægge og rør", "q": ["Er vægge pæne og rene?", "Hvis der er rør i produktionsområdet, er disse rene og pæne?", "Er fliser og fuger intakte?"]}, {"t": "Generelt", "q": ["Medarbejdere viden", "Medarbejdere påklædning og adfærd", "Affaldshåndtering", "Sæbe og rengøringsmidler"]}],
    "Forberedelsesområde": [{"t": "Fryser", "q": ["Er temperaturen ok?", "Er der risiko for krydskontaminering?", "Er der datomærke på varerne?", "Er der varer, som er for gamle?", "Er køleskabet pænt og rent indvendigt?", "Er køleskabet pænt og rent udvendigt?"]}, {"t": "Produkter, som opbevares i dette område", "q": ["Er der datomærke på?", "Er der risiko for krydskontaminering?", "Andet:"]}, {"t": "Borde og hylder", "q": ["Er bordene rene og pæne?", "Er hylderne pæne og rene?", "Er kasser, som bruges til opbevaring pæne og rene?", "Er udstyret, som opbevares i området, pæne og rene?", "Andet"]}, {"t": "Gulvet", "q": ["Er gulvet pænt og rent?", "Er der riste i afløb?", "Er afløbene pæne og rene?", "Er kanter, lister og gulv intakt?", "Andet:"]}, {"t": "Vægge og rør", "q": ["Er vægge pæne og rene?", "Hvis der er rør i produktionsområdet, er disse rene og pæne?", "Er fliser og fuger intakte?"]}, {"t": "Generelt", "q": ["Affaldshåndtering", "Hygiejnisk produktion"]}],
    "Kold produktionsområde": [{"t": "Køledisk", "q": ["Er temperaturen ok?", "Er der risiko for krydskontaminering?", "Er der datomærke på varerne?", "Er der varer, som er for gamle?", "Er køleskabet pænt og rent indvendigt?", "Er køleskabet pænt og rent udvendigt?", "Andet"]}, {"t": "Udstyr", "q": ["Varmelamper", "Filmdispenser", "Toaster", "Buffetudstyr", "Skærebræt"]}, {"t": "Borde og hylder", "q": ["Er bordene rene og pæne?", "Er hylderne pæne og rene?", "Er udstyret, som opbevares i området, pæne og rene?", "Er kasser, som bruges til opbevaring pæne og rene?", "Andet"]}, {"t": "Gulvet", "q": ["Er gulvet pænt og rent?", "Er der riste i afløb?", "Er afløbene pæne og rene?", "Er udstyr til gulvvask i orden?", "Er kanter, lister og gulv intakt?", "Andet:"]}, {"t": "Vægge, loft og rør", "q": ["Er vægge pæne og rene?", "Hvis der er rør i produktionsområdet, er disse rene og pæne?", "Er fliser og fuger intakte?"]}, {"t": "Generelt", "q": ["Affaldshåndtering"]}],
    "Varm produktion": [{"t": "Kølebord", "q": ["Er temperaturen ok?", "Er der risiko for krydskontaminering?", "Er der datomærke på varerne?", "Er der varer, som er for gamle?", "Er køleskabet pænt og rent indvendigt?", "Er køleskabet pænt og rent udvendigt?"]}, {"t": "Fryser", "q": ["Er temperaturen ok?", "Er der risiko for krydskontaminering?", "Er der datomærke på varerne?", "Er der varer, som er for gamle?", "Er fryseren pænt og rent indvendigt?", "Er fryseren pænt og rent udvendigt?"]}, {"t": "Udstyr", "q": ["Komfur", "friture", "Stegeplade", "Grill", "Skuffer og hylder under udstyr"]}, {"t": "Borde og hylder", "q": ["Er hylderne pæne og rene?", "Er bordene rene og pæne?", "Er kasser, som bruges til opbevaring pæne og rene?", "Andet"]}, {"t": "Gulvet", "q": ["Er gulvet pænt og rent?", "Er der riste i afløb?", "Er afløbene pæne og rene?", "Er kanter, lister og gulv intakt?", "Andet:"]}, {"t": "Vægge og rør", "q": ["Er vægge pæne og rene?", "Hvis der er rør i produktionsområdet, er disse rene og pæne?", "Er fliser og fuger intakte?"]}, {"t": "Generelt", "q": ["Affaldshåndtering"]}]
  },
  foh: {
    "Lagerrum": [{"t": "Fadølsanlæg", "q": ["Bliver procedure for rengøring fulgt efter anvisning fra leverandør?", "Er der datoer på anbrud for sirup?", "Er der sirupper, som er løbet på dato?", "Er slanger og tuber pæne og rene?"]}, {"t": "Gulvet", "q": ["Er gulvet pænt og rent?", "Er alt løftet over gulvhøjde?", "Er lister og fuger intakte?"]}, {"t": "Vægge og loft", "q": ["Er vægge og loft pæne og rene?"]}, {"t": "Lagerbeholdning", "q": ["Er FIFO overholdt?", "Er der datovarer?", "Er hylder pæne og rene?"]}, {"t": "Køleskab", "q": ["Er temperaturen ok?", "Er der risiko for krydskontaminering?", "Er der datomærke på varerne?", "Er der varer, som er for gamle?", "Er køleskabet pænt og rent indvendigt?", "Er køleskabet pænt og rent udvendigt?"]}],
    "Barområde": [{"t": "Bar", "q": ["Er der en god orden?", "Er der rent og pænt?", "Er smileyordning korrekt skiltet?", "Er der skilt med info om allergener?"]}, {"t": "Gulvet", "q": ["Er gulvet pænt og rent?", "Er alt løftet over gulvhøjde?", "Er lister og fuger intakte?"]}, {"t": "Køledisk", "q": ["Er temperaturen ok?", "Er der datomærke på varerne?", "Er der varer, som er for gamle?", "Er køleskabet pænt og rent indvendigt?", "Er køleskabet pænt og rent udvendigt?", "Andet:", "Ismaskinen"]}],
    "Café og gæsteområde": [{"t": "Generelt", "q": ["Er der pænt og rent?", "Er der støvet af?", "Er gulv, lister og døre skadedyrssikret?"]}],
    "Administrativt": [{"t": "Varemodtagelse", "q": ["Er der købt varer udenfor leverandører?", "Er der styr på følgesedler?", "Er der styr på tilbagekaldelser?"]}, {"t": "Egenkontrol", "q": ["Kan medarbejdere navigerer i Esmiley?", "Tjekke punkter i egenkontrollen.", "Tjekke afvigelsesrapporter"]}]
  }
};
/* ==================== SLUT PÅ KONFIGURATION ==================== */

const $ = id => document.getElementById(id);
let tab = 'boh';
let state = {};   // { "sektion|område|spørgsmål": {s:0-3, k:"kommentar"} }

/* ---------- nøgle / gem ---------- */
const key = () => 'kaiserkontrol:' + $('afd').value + ':' + $('dato').value;
function gem(){
  localStorage.setItem(key(), JSON.stringify({
    kontrollant: $('kontrollant').value,
    opsum: $('opsum').value,
    state: state
  }));
}
function hent(){
  let raw = localStorage.getItem(key());
  let o = raw ? JSON.parse(raw) : {};
  state = o.state || {};
  $('kontrollant').value = o.kontrollant || '';
  $('opsum').value = o.opsum || '';
  render();
}

/* ---------- opsætning ---------- */
AFDELINGER.forEach(a => {
  let op = document.createElement('option');
  op.value = a.navn; op.textContent = a.navn;
  $('afd').appendChild(op);
});
$('dato').value = new Date().toISOString().slice(0,10);
$('afd').onchange = hent;
$('dato').onchange = hent;
$('kontrollant').oninput = gem;
$('opsum').oninput = gem;

function setTab(t){
  tab = t;
  $('tBoh').className = t==='boh' ? 'on' : '';
  $('tFoh').className = t==='foh' ? 'on' : '';
  $('tRes').className = t==='res' ? 'on' : '';
  $('areas').className = t==='res' ? 'hide' : '';
  $('result').className = t==='res' ? '' : 'hide';
  if(t!=='res') render();
  else renderResultat();
  window.scrollTo(0,0);
}

/* ---------- render skema ---------- */
function render(){
  $('hTitle').textContent = 'Kaiser Kontrol — ' + $('afd').value;
  $('hSub').textContent = (tab==='foh' ? 'Front of house' : 'Back of house') + ' · ' + $('dato').value;
  if(tab==='res') return;
  const sek = DATA[tab];
  let h = '';
  for(const omr in sek){
    const t = tal(tab, omr);
    h += '<details class="area"><summary><span class="nm">'+omr+'</span><span class="pills">'
       + pill('g',t[1]) + pill('y',t[2]) + pill('r',t[3]) + '</span></summary>';
    sek[omr].forEach(g => {
      h += '<div class="grp">'+esc(g.t)+'</div>';
      g.q.forEach(q => {
        const k = tab+'|'+omr+'|'+g.t+'|'+q;
        const v = state[k] || {s:0,k:''};
        h += '<div class="q'+(v.k?' hasnote':'')+'" id="q_'+hash(k)+'">'
           + '<div class="txt">'+esc(q)+'</div><div class="sev">';
        for(let s=0;s<4;s++){
          h += '<button data-s="'+s+'"'+(v.s===s?' class="on"':'')
             + ' onclick="saet(\''+esc2(k)+'\','+s+')">'+NIVEAU[s]+'</button>';
        }
        h += '</div><textarea rows="2" placeholder="Kommentar…" oninput="note(\''+esc2(k)+'\',this.value)">'
           + esc(v.k) + '</textarea></div>';
      });
    });
    const ak = 'omr|'+tab+'|'+omr;
    const av = (state[ak]||{k:''}).k;
    h += '<div class="omrnote"><label class="fld">Kommentar til '+esc(omr)+'</label>'
       + '<textarea rows="3" placeholder="Samlet kommentar til området…" '
       + 'oninput="note(\''+esc2(ak)+'\',this.value)">'+esc(av)+'</textarea></div>';
    h += '</details>';
  }
  $('areas').innerHTML = h;
  opdaterBar();
}

function saet(k,s){
  const v = state[k] || {s:0,k:''};
  v.s = s; state[k] = v;
  gem();
  const el = $('q_'+hash(k));
  el.querySelectorAll('.sev button').forEach(b => {
    b.className = (+b.dataset.s === s) ? 'on' : '';
  });
  if(s>0) el.classList.add('open');
  if(s>0) { const ta = el.querySelector('textarea'); setTimeout(()=>ta.focus(),50); }
  opdaterPills();
  opdaterBar();
}
function note(k,val){
  const v = state[k] || {s:0,k:''};
  v.k = val; state[k] = v; gem();
}

/* ---------- optælling (samme pointsystem som arket) ---------- */
function tal(sek, omr){
  const t = [0,0,0,0];
  const grp = DATA[sek][omr];
  grp.forEach(g => g.q.forEach(q => {
    const v = state[sek+'|'+omr+'|'+g.t+'|'+q];
    t[v ? v.s : 0]++;
  }));
  return t;
}
function talSektion(sek){
  const t = [0,0,0,0];
  for(const omr in DATA[sek]){
    const a = tal(sek,omr);
    for(let i=0;i<4;i++) t[i]+=a[i];
  }
  return t;
}
function pill(c,n){ return '<span class="pill '+(n?c:'z')+'">'+n+'</span>'; }

function opdaterPills(){
  const sek = DATA[tab]; let i=0;
  document.querySelectorAll('#areas .area').forEach(d => {
    const omr = Object.keys(sek)[i++];
    const t = tal(tab,omr);
    d.querySelector('.pills').innerHTML = pill('g',t[1])+pill('y',t[2])+pill('r',t[3]);
  });
}
function opdaterBar(){
  const b = talSektion('boh'), f = talSektion('foh');
  const g=b[1]+f[1], y=b[2]+f[2], r=b[3]+f[3];
  $('barSum').innerHTML = pill('g',g)+pill('y',y)+pill('r',r);
}

/* ---------- resultat ---------- */
function tabel(sek){
  let h = '<tr><td></td><td class="n"><span class="dot" style="background:var(--gron)"></span></td>'
        + '<td class="n"><span class="dot" style="background:var(--gul)"></span></td>'
        + '<td class="n"><span class="dot" style="background:var(--rod)"></span></td></tr>';
  for(const omr in DATA[sek]){
    const t = tal(sek,omr);
    h += '<tr><td>'+omr+'</td><td class="n">'+t[1]+'</td><td class="n">'+t[2]+'</td><td class="n">'+t[3]+'</td></tr>';
  }
  const s = talSektion(sek);
  h += '<tr class="tot"><td>I ALT</td><td class="n">'+s[1]+'</td><td class="n">'+s[2]+'</td><td class="n">'+s[3]+'</td></tr>';
  return h;
}
function renderResultat(){
  $('resBoh').innerHTML = tabel('boh');
  $('resFoh').innerHTML = tabel('foh');
  const b = talSektion('boh'), f = talSektion('foh');
  $('resAll').innerHTML =
      '<tr><td>Back of house</td><td class="n">'+b[1]+'</td><td class="n">'+b[2]+'</td><td class="n">'+b[3]+'</td></tr>'
    + '<tr><td>Front of house</td><td class="n">'+f[1]+'</td><td class="n">'+f[2]+'</td><td class="n">'+f[3]+'</td></tr>'
    + '<tr class="tot"><td>I ALT</td><td class="n">'+(b[1]+f[1])+'</td><td class="n">'+(b[2]+f[2])+'</td><td class="n">'+(b[3]+f[3])+'</td></tr>';
  const kontrolleret = b[0]+b[1]+b[2]+b[3]+f[0]+f[1]+f[2]+f[3];
  $('resMeta').textContent = kontrolleret + ' kontrolpunkter i alt · '
    + (b[1]+f[1]+b[2]+f[2]+b[3]+f[3]) + ' bemærkninger · '
    + ($('kontrollant').value || 'kontrollant ikke angivet');
  opdaterBar();
}

/* ---------- mail ---------- */
function afsnit(sek, navn){
  let ud = '', fundet = false;
  for(const omr in DATA[sek]){
    let linjer = '';
    DATA[sek][omr].forEach(g => g.q.forEach(q => {
      const v = state[sek+'|'+omr+'|'+g.t+'|'+q];
      if(v && v.s > 0){
        linjer += '  [' + NIVEAU[v.s].toUpperCase() + '] ' + g.t + ' > ' + q + (v.k ? ' - ' + v.k : '') + '\n';
        fundet = true;
      }
    }));
    const omrK = (state['omr|'+sek+'|'+omr] || {k:''}).k.trim();
    if(linjer || omrK){
      const t = tal(sek,omr);
      ud += omr + '  (gron ' + t[1] + ' / gul ' + t[2] + ' / rod ' + t[3] + ')\n' + linjer;
      if(omrK) ud += '  Kommentar til omradet: ' + omrK + '\n';
      ud += '\n';
      fundet = true;
    }
  }
  const s = talSektion(sek);
  let head = navn.toUpperCase() + ' - gron ' + s[1] + ' / gul ' + s[2] + ' / rod ' + s[3] + '\n'
           + '------------------------------------------\n';
  return head + (fundet ? ud : 'Ingen bemarkninger.\n\n');
}
function sendMail(){
  const afd = AFDELINGER.find(a => a.navn === $('afd').value) || {mail:''};
  const b = talSektion('boh'), f = talSektion('foh');
  let body =
      'Intern fodevarekontrol\n'
    + 'Afdeling: ' + $('afd').value + '\n'
    + 'Dato: ' + $('dato').value + '\n'
    + 'Kontrollant: ' + ($('kontrollant').value || '-') + '\n\n'
    + 'SAMLET RESULTAT\n'
    + '  Gron (mindre bemarkning): ' + (b[1]+f[1]) + '\n'
    + '  Gul (skal rettes):        ' + (b[2]+f[2]) + '\n'
    + '  Rod (alvorlig):           ' + (b[3]+f[3]) + '\n\n'
    + afsnit('boh','Back of house')
    + afsnit('foh','Front of house');
  if($('opsum').value.trim()){
    body += 'SAMLET KOMMENTAR\n------------------------------------------\n' + $('opsum').value.trim() + '\n\n';
  }
  body += 'Rode punkter rettes straks. Gule punkter rettes inden naste kontrol.\n';

  const emne = 'Intern kontrol - ' + $('afd').value + ' - ' + $('dato').value
             + ' (' + (b[1]+f[1]) + '/' + (b[2]+f[2]) + '/' + (b[3]+f[3]) + ')';
  let url = 'mailto:' + encodeURIComponent(afd.mail)
          + '?subject=' + encodeURIComponent(emne)
          + (CC_MAIL ? '&cc=' + encodeURIComponent(CC_MAIL) : '')
          + '&body=' + encodeURIComponent(body);
  window.location.href = url;
}

function nulstil(){
  if(!confirm('Slet alle svar for ' + $('afd').value + ' den ' + $('dato').value + '?')) return;
  localStorage.removeItem(key());
  state = {}; $('opsum').value = '';
  render(); renderResultat();
}

/* ---------- hjalpere ---------- */
function esc(s){ return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
function esc2(s){ return String(s).replace(/\\/g,'\\\\').replace(/'/g,"\\'"); }
function hash(s){ let h=0; for(let i=0;i<s.length;i++){ h=(h*31+s.charCodeAt(i))|0; } return 'k'+Math.abs(h); }

hent();
setTab('boh');
</script>
