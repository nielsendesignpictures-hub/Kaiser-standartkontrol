<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Kaiser — Recipes</title>
<style>
  :root {
    --bg:        #f6f4ef;
    --card:      #ffffff;
    --border:    #e3ded4;
    --ink:       #26241f;
    --muted:     #8a857a;
    --gold:      #a8842c;
    --gold-bg:   #f5edd8;
    --green:     #3e7a4e;
    --green-bg:  #e8f2ea;
    --shadow:    0 1px 3px rgba(60,50,30,.08);
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }
  html { -webkit-text-size-adjust: 100%; }

  body {
    background: var(--bg);
    color: var(--ink);
    font-family: 'Inter', 'Segoe UI', system-ui, sans-serif;
    font-size: 17px;
    line-height: 1.6;
    min-height: 100vh;
  }

  /* ═══════════ HEADER ═══════════ */
  .header {
    background: var(--card);
    border-bottom: 1px solid var(--border);
    padding: 20px 20px 0;
    position: sticky;
    top: 0;
    z-index: 50;
  }
  .header-row {
    display: flex;
    align-items: center;
    gap: 12px;
    max-width: 1100px;
    margin: 0 auto;
  }
  .header h1 {
    font-size: 22px;
    font-weight: 800;
    letter-spacing: -.02em;
    flex: 1;
  }
  .header h1 span { color: var(--gold); }
  .count-badge {
    font-size: 13px;
    font-weight: 600;
    color: var(--muted);
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 20px;
    padding: 4px 12px;
    white-space: nowrap;
  }

  /* Search */
  .search-row {
    max-width: 1100px;
    margin: 14px auto 0;
  }
  .search-input {
    width: 100%;
    font-size: 17px;
    padding: 14px 18px;
    border: 2px solid var(--border);
    border-radius: 12px;
    background: var(--bg);
    color: var(--ink);
    outline: none;
    transition: border-color .15s;
  }
  .search-input:focus { border-color: var(--gold); background: #fff; }
  .search-input::placeholder { color: var(--muted); }

  /* Category tabs */
  .tabs {
    max-width: 1100px;
    margin: 14px auto 0;
    display: flex;
    gap: 8px;
    overflow-x: auto;
    padding-bottom: 14px;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .tabs::-webkit-scrollbar { display: none; }
  .tab {
    font-size: 15px;
    font-weight: 600;
    padding: 10px 20px;
    border-radius: 24px;
    border: 2px solid var(--border);
    background: var(--card);
    color: var(--muted);
    cursor: pointer;
    white-space: nowrap;
    transition: all .15s;
  }
  .tab:active { transform: scale(.97); }
  .tab.active {
    background: var(--ink);
    border-color: var(--ink);
    color: #fff;
  }

  /* ═══════════ RECIPE LIST ═══════════ */
  .list-wrap {
    max-width: 1100px;
    margin: 0 auto;
    padding: 20px;
  }
  .cat-section { margin-bottom: 28px; }
  .cat-heading {
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .1em;
    color: var(--gold);
    margin-bottom: 10px;
    padding-left: 4px;
  }
  .recipe-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 10px;
  }
  .recipe-row {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 16px 18px;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 14px;
    box-shadow: var(--shadow);
    transition: transform .1s, border-color .15s;
  }
  .recipe-row:active { transform: scale(.99); }
  .recipe-row:hover { border-color: var(--gold); }
  .row-info { flex: 1; min-width: 0; }
  .row-name {
    font-size: 17px;
    font-weight: 700;
    letter-spacing: -.01em;
  }
  .row-yield {
    font-size: 13px;
    color: var(--muted);
    margin-top: 1px;
  }
  .row-arrow {
    color: var(--gold);
    font-size: 20px;
    font-weight: 700;
    flex-shrink: 0;
  }

  .empty {
    text-align: center;
    padding: 70px 20px;
    color: var(--muted);
  }
  .empty .big { font-size: 40px; margin-bottom: 10px; }

  /* ═══════════ RECIPE VIEW ═══════════ */
  .recipe-view {
    display: none;
    max-width: 760px;
    margin: 0 auto;
    padding: 20px 20px 60px;
  }
  .recipe-view.open { display: block; }
  .list-view.hidden { display: none; }
  .header.hidden { display: none; }

  /* Recipe header */
  .rv-topbar {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px 0;
    position: sticky;
    top: 0;
    background: var(--bg);
    z-index: 40;
  }
  .rv-back {
    font-size: 16px;
    font-weight: 700;
    color: var(--ink);
    background: var(--card);
    border: 2px solid var(--border);
    border-radius: 12px;
    padding: 12px 20px;
    cursor: pointer;
    transition: border-color .15s;
  }
  .rv-back:hover { border-color: var(--gold); }
  .rv-cat {
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .1em;
    color: var(--gold);
    background: var(--gold-bg);
    padding: 6px 14px;
    border-radius: 20px;
  }

  .rv-title {
    font-size: 32px;
    font-weight: 800;
    letter-spacing: -.03em;
    line-height: 1.15;
    margin: 10px 0 4px;
  }
  .rv-yield {
    font-size: 16px;
    color: var(--muted);
    margin-bottom: 24px;
  }

  /* Ingredients — checkable */
  .rv-section-label {
    font-size: 14px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: .1em;
    color: var(--ink);
    margin-bottom: 12px;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .rv-section-label::after {
    content: "";
    flex: 1;
    height: 1px;
    background: var(--border);
  }

  .ing-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 14px;
    box-shadow: var(--shadow);
    margin-bottom: 28px;
    overflow: hidden;
  }
  .ing-item {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 18px;
    border-bottom: 1px solid var(--border);
    cursor: pointer;
    user-select: none;
    transition: background .1s;
  }
  .ing-item:last-child { border-bottom: none; }
  .ing-item:active { background: var(--bg); }
  .ing-check {
    width: 26px;
    height: 26px;
    border: 2px solid var(--border);
    border-radius: 8px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 15px;
    color: transparent;
    transition: all .15s;
  }
  .ing-item.done .ing-check {
    background: var(--green);
    border-color: var(--green);
    color: #fff;
  }
  .ing-amount {
    font-weight: 800;
    font-size: 16px;
    color: var(--gold);
    min-width: 84px;
    flex-shrink: 0;
  }
  .ing-name { font-size: 16px; }
  .ing-item.done .ing-name,
  .ing-item.done .ing-amount {
    text-decoration: line-through;
    opacity: .45;
  }

  /* Steps — big, one focus at a time */
  .step-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 14px;
    box-shadow: var(--shadow);
    padding: 20px;
    margin-bottom: 12px;
    display: flex;
    gap: 16px;
    cursor: pointer;
    user-select: none;
    transition: border-color .15s, opacity .2s;
  }
  .step-card:active { transform: scale(.995); }
  .step-badge {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--ink);
    color: #fff;
    font-size: 17px;
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .step-card.done { opacity: .5; }
  .step-card.done .step-badge { background: var(--green); }
  .step-card.done .step-badge::before { content: "✓"; }
  .step-card.done .step-badge span { display: none; }
  .step-text { flex: 1; }
  .step-title {
    font-size: 18px;
    font-weight: 800;
    letter-spacing: -.01em;
    margin-bottom: 4px;
  }
  .step-desc {
    font-size: 16px;
    line-height: 1.65;
    color: #4a463e;
  }
  .step-card.done .step-title { text-decoration: line-through; }

  /* Important note */
  .rv-note {
    background: var(--gold-bg);
    border: 1px solid #e5d5a8;
    border-radius: 14px;
    padding: 18px 20px;
    margin-top: 20px;
    display: flex;
    gap: 12px;
    font-size: 15px;
    line-height: 1.6;
  }
  .rv-note .icon { font-size: 20px; flex-shrink: 0; }
  .rv-note strong { display: block; margin-bottom: 2px; font-size: 13px; text-transform: uppercase; letter-spacing: .08em; color: var(--gold); }

  /* Reset button */
  .rv-reset {
    display: block;
    width: 100%;
    margin-top: 24px;
    padding: 14px;
    font-size: 15px;
    font-weight: 700;
    color: var(--muted);
    background: none;
    border: 2px dashed var(--border);
    border-radius: 12px;
    cursor: pointer;
    transition: color .15s, border-color .15s;
  }
  .rv-reset:hover { color: var(--ink); border-color: var(--muted); }

  @media (min-width: 700px) {
    .rv-title { font-size: 38px; }
  }
</style>
</head>
<body>

<!-- ═══════════ LIST VIEW ═══════════ -->
<header class="header" id="header">
  <div class="header-row">
    <h1><span>Kaiser</span> Recipes</h1>
    <span class="count-badge" id="countBadge"></span>
  </div>
  <div class="search-row">
    <input class="search-input" id="searchInput" type="text" placeholder="Search recipe or ingredient…">
  </div>
  <div class="tabs" id="tabs">
    <button class="tab active" data-cat="all">All</button>
    <button class="tab" data-cat="dressing">Dressings</button>
    <button class="tab" data-cat="sauce">Sauces</button>
    <button class="tab" data-cat="pickled">Pickled</button>
    <button class="tab" data-cat="salad">Salads</button>
    <button class="tab" data-cat="misc">Misc</button>
  </div>
</header>

<main class="list-wrap list-view" id="listView"></main>

<!-- ═══════════ RECIPE VIEW ═══════════ -->
<section class="recipe-view" id="recipeView"></section>

<script>
// ════════════════════════════════════════════
//  RECIPES
//  category: "dressing" | "sauce" | "pickled" | "salad" | "misc"
//  Copy the block below to add a new recipe.
// ════════════════════════════════════════════
const RECIPES = [
  {
    id: 1,
    name: "Signature Burger Dressing",
    category: "dressing",
    yield: "Makes approx. 1.5 kg",
    ingredients: [
      ["1.2 kg",   "plain mayonnaise"],
      ["3 tbsp",   "French's mustard (yellow mustard)"],
      ["1 tbsp",   "Dijon mustard"],
      ["3 tbsp",   "ketchup"],
      ["2 tbsp",   "paprika powder (= 6 tsp)"],
      ["1 tbsp",   "dried dill (= 3 tsp)"],
      ["3 tbsp",   "sugar"],
      ["1 tbsp",   "chili sauce (= 3 tsp)"],
      ["100 g",    "pickled cucumber / gherkins, finely chopped"],
      ["100 ml",   "pickle brine (pickle juice)"],
      ["to taste", "salt and black pepper"],
    ],
    steps: [
      ["Prepare the pickles",
       "Finely chop the pickled cucumbers (or pulse briefly in a food processor). Drain off excess liquid if they are very wet."],
      ["Mix the base",
       "In a large bowl, whisk together the mayonnaise, yellow mustard, Dijon, ketchup, paprika powder, dill, sugar, and chili sauce until smooth."],
      ["Add pickles & brine",
       "Fold in the chopped pickles and pour in the pickle brine. Stir well — the brine loosens the dressing and adds the tang."],
      ["Season & rest",
       "Season with salt and black pepper. Cover and refrigerate at least 1 hour before use — the flavour develops as it rests."],
      ["Store",
       "Transfer to labelled containers. Keeps refrigerated up to 5 days. Stir before each use."],
    ],
    note: "Make in full batch only — scaling down affects the brine ratio. Taste after resting, not right after mixing."
  },

  // ── COPY THIS BLOCK TO ADD A RECIPE ──
  // {
  //   id: 2,
  //   name: "Recipe name",
  //   category: "sauce",
  //   yield: "Makes approx. ...",
  //   ingredients: [
  //     ["amount", "ingredient"],
  //   ],
  //   steps: [
  //     ["Step title", "What to do."],
  //   ],
  //   note: ""   // leave empty if none
  // },
];

const CAT_LABELS = { dressing:"Dressings", sauce:"Sauces", pickled:"Pickled", salad:"Salads", misc:"Misc" };
const CAT_ORDER  = ["dressing","sauce","pickled","salad","misc"];

let activeCat = "all";
let query = "";

// ════════ LIST ════════
function matches(r) {
  const q = query.toLowerCase();
  if (activeCat !== "all" && r.category !== activeCat) return false;
  if (!q) return true;
  return r.name.toLowerCase().includes(q) ||
         r.ingredients.some(i => i[1].toLowerCase().includes(q));
}

function renderList() {
  const view = document.getElementById("listView");
  const hits = RECIPES.filter(matches);
  document.getElementById("countBadge").textContent = RECIPES.length + " recipes";

  if (!hits.length) {
    view.innerHTML = `<div class="empty"><div class="big">🔍</div>No recipes found.</div>`;
    return;
  }

  // Group by category (in fixed order)
  let html = "";
  for (const cat of CAT_ORDER) {
    const group = hits.filter(r => r.category === cat);
    if (!group.length) continue;
    html += `<div class="cat-section">
      <div class="cat-heading">${CAT_LABELS[cat]}</div>
      <div class="recipe-list">
        ${group.map(r => `
          <div class="recipe-row" data-id="${r.id}">
            <div class="row-info">
              <div class="row-name">${r.name}</div>
              <div class="row-yield">${r.yield}</div>
            </div>
            <span class="row-arrow">→</span>
          </div>`).join("")}
      </div>
    </div>`;
  }
  view.innerHTML = html;

  view.querySelectorAll(".recipe-row").forEach(row =>
    row.addEventListener("click", () => openRecipe(+row.dataset.id)));
}

// ════════ RECIPE VIEW ════════
function openRecipe(id) {
  const r = RECIPES.find(x => x.id === id);
  if (!r) return;

  const rv = document.getElementById("recipeView");

  rv.innerHTML = `
    <div class="rv-topbar">
      <button class="rv-back" id="backBtn">← All recipes</button>
      <span class="rv-cat">${CAT_LABELS[r.category].replace(/s$/,"")}</span>
    </div>

    <h2 class="rv-title">${r.name}</h2>
    <div class="rv-yield">${r.yield}</div>

    <div class="rv-section-label">Ingredients — tap to check off</div>
    <div class="ing-card">
      ${r.ingredients.map(i => `
        <div class="ing-item">
          <span class="ing-check">✓</span>
          <span class="ing-amount">${i[0]}</span>
          <span class="ing-name">${i[1]}</span>
        </div>`).join("")}
    </div>

    <div class="rv-section-label">Method — tap when done</div>
    ${r.steps.map((s, i) => `
      <div class="step-card">
        <div class="step-badge"><span>${i+1}</span></div>
        <div class="step-text">
          <div class="step-title">${s[0]}</div>
          <div class="step-desc">${s[1]}</div>
        </div>
      </div>`).join("")}

    ${r.note ? `
      <div class="rv-note">
        <span class="icon">⚠️</span>
        <div><strong>Important</strong>${r.note}</div>
      </div>` : ""}

    <button class="rv-reset" id="resetBtn">↺ Reset checkmarks</button>
  `;

  // Toggle checkoff
  rv.querySelectorAll(".ing-item").forEach(el =>
    el.addEventListener("click", () => el.classList.toggle("done")));
  rv.querySelectorAll(".step-card").forEach(el =>
    el.addEventListener("click", () => el.classList.toggle("done")));

  document.getElementById("resetBtn").addEventListener("click", () => {
    rv.querySelectorAll(".done").forEach(el => el.classList.remove("done"));
  });

  document.getElementById("backBtn").addEventListener("click", closeRecipe);

  document.getElementById("listView").classList.add("hidden");
  document.getElementById("header").classList.add("hidden");
  rv.classList.add("open");
  window.scrollTo(0, 0);
}

function closeRecipe() {
  document.getElementById("recipeView").classList.remove("open");
  document.getElementById("listView").classList.remove("hidden");
  document.getElementById("header").classList.remove("hidden");
  window.scrollTo(0, 0);
}

// ════════ CONTROLS ════════
document.getElementById("tabs").addEventListener("click", e => {
  const btn = e.target.closest(".tab");
  if (!btn) return;
  document.querySelectorAll(".tab").forEach(t => t.classList.remove("active"));
  btn.classList.add("active");
  activeCat = btn.dataset.cat;
  renderList();
});

document.getElementById("searchInput").addEventListener("input", e => {
  query = e.target.value;
  renderList();
});

renderList();
</script>
</body>
</html>
